new file mode 100644
--- /dev/null	
+++ b/strategies/BBstrategy.py	
@@ -0,0 +1,27 @@
+def signal(lines, price):
+    center = (lines[1] + lines[0]) / 2
+    y = 0
+    if price > center:
+        m1 = 100 / (lines[1] - center)
+        y = m1 * (price - center)
+    elif price < center:
+        m2 = 100 / (center - lines[0])
+        y = m2 * (price - center)
+    return y
+
+
+def analyse(bb, sell_confidence, buy_confidence, price, last_state):
+    response = None
+    orderprice = None
+    BB_Signal = -1 * signal([bb["Bollinger_Upper"], bb["Bollinger_Lower"]], price) / 100
+
+    if BB_Signal <= buy_confidence and last_state == "sell":
+
+        response = "buy"
+        orderprice = price
+
+
+    elif BB_Signal >= sell_confidence and last_state == "buy":
+        response = "sell"
+
+    return [response, orderprice]
